{
  "rewrites": [
    {
      "source": "/invite/:guest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/preview?type=vip&guest=:guest*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/encargado",
      "destination": "/index.html"
    },
    {
      "source": "/b",
      "destination": "/index.html"
    },
    {
      "source": "/invite/:guest*",
      "destination": "/index.html"
    },
    {
      "source": "/vip/:guest*",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
