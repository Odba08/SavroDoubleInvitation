{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/vip.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/vip.html"
    },
    {
      "source": "/encargado",
      "destination": "/vip.html"
    },
    {
      "source": "/vip",
      "destination": "/vip.html"
    },
    {
      "source": "/vip/:guest*",
      "destination": "/vip.html"
    },
    {
      "source": "/invite/:guest*",
      "destination": "/vip.html"
    },
    {
      "source": "/i/:guest*",
      "destination": "/vip.html"
    },
    {
      "source": "/b",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
