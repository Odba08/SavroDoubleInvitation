{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/invite/:guest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/preview?type=vip&guest=:guest*"
    },
    {
      "source": "/(b|18|opening)?",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/preview?type=opening"
    },
    {
      "source": "/((?!api/|assets/|og-|pattern|savro_).*)",
      "destination": "/index.html"
    }
  ]
}
